# AI API Keys
GOOGLE_GENERATIVE_AI_API_KEY=your-google-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Supabase Configurations (Web Application & Server-side API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase Configurations (Scripts & Database Seeding)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis-instance-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here

# Cron Jobs Security
CRON_SECRET=your-cron-secret-token-here
